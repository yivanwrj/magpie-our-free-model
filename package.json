{
  "name": "magpie-our-free-model",
  "version": "0.14.2",
  "description": "Our Free Model for Magpie: free pools, automatic EAC setup, account management and accountless Cloudflare console",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs",
    "./compatibility": "./compatibility.mjs"
  },
  "files": [
    "index.mjs",
    "uninstall.mjs",
    "compatibility.mjs",
    "src",
    "assets",
    "vendor",
    "scripts",
    "tests",
    "README.md",
    "VALIDATION.md",
    "UPSTREAM_SYNC.md",
    "NOTICE.md",
    "LICENSE",
    "INSTALL_ZH.md",
    "TEST_RESULTS.txt",
    "Open-OFM-Console.command",
    "Open-OFM-Console.cmd",
    "Open-OFM-Console.ps1",
    "UPSTREAM_POLICY.json",
    "AUTO_UPDATE_ZH.md",
    "UPGRADE_ZH.md",
    "MAINTENANCE_ZH.md",
    "CLEANUP_ZH.md",
    "CONSOLE_INTEGRATION_ZH.md",
    "COMMUNITY_REVIEW_ZH.md",
    "RTK_DSH_ZH.md",
    "UPDATE_SECURITY_ZH.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "provider",
    "free-model",
    "our-free-model"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mu-zi-lee/magpie-our-free-model.git"
  },
  "homepage": "https://github.com/mu-zi-lee/magpie-our-free-model#readme",
  "bugs": {
    "url": "https://github.com/mu-zi-lee/magpie-our-free-model/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "https://raw.githubusercontent.com/mu-zi-lee/magpie-our-free-model/main/assets/icon.webp",
    "maxConcurrency": 2,
    "uninstall": "./uninstall.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs vendor/zen-free/*.test.mjs",
    "check": "node scripts/check.mjs",
    "console": "node scripts/open-console.mjs",
    "upstream:check": "node scripts/sync-upstream.mjs",
    "upstream:build": "node scripts/sync-upstream.mjs --build",
    "upstream:apply": "node scripts/apply-upstream.mjs",
    "service:status": "node scripts/service-status.mjs"
  }
}
